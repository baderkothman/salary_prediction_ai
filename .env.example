# Copy this file to .env and fill in real values. Never commit .env.

# ===== Shared: backend API + local generation pipeline =====
APP_ENV=development
LOG_LEVEL=INFO

# Model artifact locations (relative to repo root)
MODEL_PATH=ml/artifacts/model/salary_model.joblib
MODEL_METADATA_PATH=ml/artifacts/model/model_metadata.json

# Backend (FastAPI) service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local API base URL used by the pipeline's Python API client
LOCAL_API_BASE_URL=http://127.0.0.1:8000
HTTP_TIMEOUT_SECONDS=15

# Ollama (local LLM analysis for the generation pipeline -- ALWAYS local,
# regardless of NARRATOR_PROVIDER below; scripts/run_pipeline.py never uses
# a cloud API). llama3.2:latest, not qwen3, by measurement: qwen3 is a
# reasoning model that (with "think" disabled, required for non-empty
# output) just echoes the input JSON back instead of analyzing it.
# See docs/ollama_model_choice.md.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Backend /narrate endpoint ONLY: which narrator to use. "ollama" (default)
# for local dev, where Ollama runs alongside the API. Deployments that can't
# reach a local Ollama instance (e.g. Render) set NARRATOR_PROVIDER=gemini
# and GEMINI_API_KEY instead -- see backend/app/services/gemini_client.py
# and README.md's Deployment section for the privacy trade-off.
NARRATOR_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase — backend/pipeline only. Service role key must NEVER reach the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Frontend (Vite) =====
# Only anon-safe values may be prefixed VITE_. Never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend URL for the live /predict page ONLY (lib/api.ts) -- every other
# page reads exclusively from Supabase. Requires the backend AND Ollama
# both running locally to fully work; defaults to localhost:8000 if unset.
VITE_API_BASE_URL=http://127.0.0.1:8000
