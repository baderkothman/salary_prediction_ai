# Copy this file to .env and fill in real values. Never commit .env.

# ===== Shared: backend API + local generation pipeline =====
APP_ENV=development
LOG_LEVEL=INFO

# Model artifact locations (relative to repo root)
MODEL_PATH=ml/artifacts/model/salary_model.joblib
MODEL_METADATA_PATH=ml/artifacts/model/model_metadata.json

# Backend (FastAPI) service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local API base URL used by the pipeline's Python API client
LOCAL_API_BASE_URL=http://127.0.0.1:8000
HTTP_TIMEOUT_SECONDS=15

# Ollama (local LLM analysis — never replaced with an external LLM API)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Supabase — backend/pipeline only. Service role key must NEVER reach the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Frontend (Vite) =====
# Only anon-safe values may be prefixed VITE_. Never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
